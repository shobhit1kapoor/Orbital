    CL --> W["WATCHTOWER<br/>runtime attestation"]
    AR["Agent runtime"] --> G["GATE<br/>action escrow"]
    G --> T["Synthetic local tools"]
    AR --> P["PARALLAX<br/>evidence reconciler"]
    T --> P
    OBI["OBI / eBPF"] --> P
    OPA["OPA decisions"] --> P
    AR & G & P & RP & F & FR & CL & W --> OTEL["OpenTelemetry Collector"]
